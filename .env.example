# Copy to .env (never commit .env). Defaults below match infra/docker-compose.yml for local development.

# Backend database: the app runs as nadel_app (no BYPASSRLS), migrations as nadel_owner
NADEL_DB_URL=jdbc:postgresql://localhost:5432/nadel
NADEL_DB_APP_USER=nadel_app
NADEL_DB_APP_PASSWORD=nadel_app
NADEL_DB_OWNER_USER=nadel_owner
NADEL_DB_OWNER_PASSWORD=nadel_owner

# Keycloak issuer used by the backend to validate JWTs
NADEL_OIDC_ISSUER=http://localhost:8180/realms/nadel

# Spring profile: dev loads demo data; use prod in deployed environments
SPRING_PROFILES_ACTIVE=dev

# Web app variables live in web/.env (see web/.env.example)
