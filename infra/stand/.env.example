# Copy to /opt/nadel/.env on the server, fill in, then: chmod 600 .env. Never commit the filled file.
# Generate every secret with: openssl rand -base64 32   (passwords: openssl rand -hex 16)

# Domain whose A record points at the server
NADEL_DOMAIN=nadel.example.com

# ARM server (Hetzner CAX) only:
# NADEL_POSTGIS_IMAGE=imresamu/postgis:17-3.5

POSTGRES_PASSWORD=
NADEL_DB_OWNER_PASSWORD=
NADEL_DB_APP_PASSWORD=
KC_DB_PASSWORD=
KC_ADMIN_PASSWORD=

# Personal data master key (32 bytes, base64). The stand holds demo data only, but the key still must not be lost
# while the stand lives: without it the demo contacts cannot be opened.
NADEL_PD_MASTER_KEY=

# New password for chairman@, treasurer@, electrician@ and member@demo.local (stand-init.sh sets it)
# at least 8 characters (realm password policy length(8))
STAND_USER_PASSWORD=

# Keep the stand out of search engines (Caddy sends X-Robots-Tag: noindex); false only on a public site
NADEL_NOINDEX=true
# Written by ./stand-init.sh (rotated on every run); do not choose it by hand
NADEL_KEYCLOAK_ADMIN_CLIENT_SECRET=

# Web Push (VAPID). ./stand-init.sh generates the key pair when both are empty and keeps it on later runs; leave them empty.
# Rotating the pair drops every phone's subscription. Empty subject = mailto:admin@NADEL_DOMAIN.
NADEL_WEBPUSH_PUBLIC_KEY=
NADEL_WEBPUSH_PRIVATE_KEY=
NADEL_WEBPUSH_SUBJECT=
