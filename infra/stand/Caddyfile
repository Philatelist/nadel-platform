{$NADEL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Keep the stand out of search engines; set NADEL_NOINDEX=false on a real public site that wants the help indexed
	@noindex expression `"{$NADEL_NOINDEX:true}" == "true"`
	header @noindex X-Robots-Tag "noindex, nofollow"

	# The Keycloak admin console and admin API are reachable only through the SSH tunnel (compose.yml)
	handle /auth/admin* {
		respond 404
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	# The service worker, the manifest and the app shell must never be served from a cache, or an old app outlives a deploy.
	# A missing sw.js is a plain 404 (no fallback to index.html, which a browser would try to run as a worker).
	@shell path /sw.js /manifest.webmanifest /index.html
	handle @shell {
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	# Hashed build files never change under the same name
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# The web build; unknown paths go to index.html (client-side routing); pre-rendered help shells are /help/index.html and /help/<id>/index.html
	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
