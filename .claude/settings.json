{
  "extraKnownMarketplaces": {
    "awos-marketplace": {
      "source": {
        "source": "github",
        "repo": "provectus/awos"
      }
    }
  },
  "enabledPlugins": {
    "awos@awos-marketplace": true
  },
  "permissions": {
    "allow": [
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git push)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run rerun*)",
      "Bash(make up*)",
      "Bash(make infra*)",
      "Bash(docker compose -f infra/docker-compose.yml*)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push --tags*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh api*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.mcp.json)"
    ]
  }
}
