{
  "extraKnownMarketplaces": {
    "awos-marketplace": {
      "source": {
        "source": "github",
        "repo": "provectus/awos"
      }
    }
  },
  "enabledPlugins": {
    "awos@awos-marketplace": true
  },
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.mcp.json)"
    ]
  }
}
